# Template for compose.prod.yaml. Copy to .env.prod (gitignored) and fill in.
# cp .env.prod.example .env.prod
#
# docker compose -f compose.prod.yaml --env-file .env.prod up -d --build
#
# No real credentials belong in this tracked example file.

# Infrastructure (required for the stack to start at all).
POSTGRES_DB=gerez
POSTGRES_USER=gerez
POSTGRES_PASSWORD=
MINIO_ROOT_USER=gerez-storage
MINIO_ROOT_PASSWORD=
STORAGE_BUCKET=gerez-images
BETTER_AUTH_SECRET=
PROXY_SECRET=

# Email (Resend). Leave blank to run as a demo: sign-in stays explicitly
# unavailable instead of silently succeeding. Fill in once gerez.pt is a
# verified Resend sending domain to enable real OTP login.
SUPPORT_EMAIL=support@gerez.pt
RESEND_API_KEY=
EMAIL_FROM=GEREZ <onboarding@resend.dev>

# Payments (Stripe). Leave blank to run as a demo: checkout stays explicitly
# unavailable instead of a fake success. Fill in restricted live/test keys
# and a card-only STRIPE_PAYMENT_METHOD_CONFIGURATION before going live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# Shipping/tax business policy. Leave blank for the demo; required before
# accepting real orders. SHIPPING_COUNTRIES is comma-separated ISO codes,
# SHIPPING_PRICE_MINOR is an integer in EUR cents, TAX_POLICY is
# "not_collecting" or "included" (with TAX_RATES_JSON set accordingly).
SHIPPING_COUNTRIES=
SHIPPING_PRICE_MINOR=0
TAX_POLICY=
TAX_RATES_JSON={}
